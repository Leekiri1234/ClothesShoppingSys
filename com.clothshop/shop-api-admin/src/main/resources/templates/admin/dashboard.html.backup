<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title>Dashboard</title>
</head>
<body>

<h1 layout:fragment="page-title">Dashboard</h1>

<div layout:fragment="content">
    <!-- STAT CARDS -->
    <div class="stat-cards">
        <div class="stat-card">
            <div class="stat-icon" style="background: #f0f7ff;">
                <svg style="width: 20px; height: 20px; color: #2196F3;" viewBox="0 0 24 24">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Doanh thu hôm nay</div>
                <div class="stat-value">12.5M</div>
                <div class="stat-trend up">↑ 12% so với hôm qua</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: #e8f5e9;">
                <svg style="width: 20px; height: 20px; color: #4CAF50;" viewBox="0 0 24 24">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Đơn hàng mới</div>
                <div class="stat-value">28</div>
                <div class="stat-trend up">↑ 8 đơn mới</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: #fff3e0;">
                <svg style="width: 20px; height: 20px; color: #f0a500;" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Khách hàng</div>
                <div class="stat-value">1,245</div>
                <div class="stat-trend up">↑ 15 khách mới</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: #fdecea;">
                <svg style="width: 20px; height: 20px; color: #e63946;" viewBox="0 0 24 24">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
            </div>
            <div class="stat-body">
                <div class="stat-label">Sản phẩm</div>
                <div class="stat-value">342</div>
                <div class="stat-trend down">↓ 5 hết hàng</div>
            </div>
        </div>
    </div>

    <!-- DASHBOARD GRID -->
    <div class="dashboard-grid">
        <!-- REVENUE CHART -->
        <div class="dashboard-card chart-card">
            <div class="card-header">
                <h3>Doanh thu 7 ngày qua</h3>
                <div class="date-range-selector">
                    <button class="range-btn active">7 ngày</button>
                    <button class="range-btn">30 ngày</button>
                    <button class="range-btn">90 ngày</button>
                </div>
            </div>
            <div class="chart-container" id="revenueChart" data-chart></div>
            <div class="chart-labels">
                <div class="chart-label">T2</div>
                <div class="chart-label">T3</div>
                <div class="chart-label">T4</div>
                <div class="chart-label">T5</div>
                <div class="chart-label">T6</div>
                <div class="chart-label">T7</div>
                <div class="chart-label">CN</div>
            </div>
        </div>

        <!-- RECENT ORDERS -->
        <div class="dashboard-card">
            <div class="card-header">
                <h3>Đơn hàng gần đây</h3>
                <a th:href="@{/admin/orders}" class="card-link">Xem tất cả</a>
            </div>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>#ORD001</td>
                        <td>Nguyễn Văn A</td>
                        <td>1.250.000₫</td>
                        <td><span class="badge badge-warning">Chờ xác nhận</span></td>
                    </tr>
                    <tr>
                        <td>#ORD002</td>
                        <td>Trần Thị B</td>
                        <td>890.000₫</td>
                        <td><span class="badge badge-info">Đang giao</span></td>
                    </tr>
                    <tr>
                        <td>#ORD003</td>
                        <td>Lê Văn C</td>
                        <td>2.100.000₫</td>
                        <td><span class="badge badge-success">Hoàn thành</span></td>
                    </tr>
                    <tr>
                        <td>#ORD004</td>
                        <td>Phạm Thị D</td>
                        <td>650.000₫</td>
                        <td><span class="badge badge-warning">Chờ xác nhận</span></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- TOP PRODUCTS -->
        <div class="dashboard-card">
            <div class="card-header">
                <h3>Sản phẩm bán chạy</h3>
                <a th:href="@{/admin/products}" class="card-link">Xem tất cả</a>
            </div>
            <div class="top-products-list">
                <div class="top-product-item">
                    <div class="top-product-rank gold">1</div>
                    <div class="top-product-info">
                        <div class="top-product-name">Áo sơ mi trắng basic</div>
                        <div class="top-product-sold">Đã bán: 245</div>
                    </div>
                    <div class="top-product-revenue">12.5M</div>
                </div>
                <div class="top-product-item">
                    <div class="top-product-rank silver">2</div>
                    <div class="top-product-info">
                        <div class="top-product-name">Quần jean skinny đen</div>
                        <div class="top-product-sold">Đã bán: 189</div>
                    </div>
                    <div class="top-product-revenue">9.8M</div>
                </div>
                <div class="top-product-item">
                    <div class="top-product-rank bronze">3</div>
                    <div class="top-product-info">
                        <div class="top-product-name">Áo thun polo xanh navy</div>
                        <div class="top-product-sold">Đã bán: 156</div>
                    </div>
                    <div class="top-product-revenue">7.2M</div>
                </div>
                <div class="top-product-item">
                    <div class="top-product-rank">4</div>
                    <div class="top-product-info">
                        <div class="top-product-name">Váy midi hoa nhí</div>
                        <div class="top-product-sold">Đã bán: 134</div>
                    </div>
                    <div class="top-product-revenue">6.1M</div>
                </div>
                <div class="top-product-item">
                    <div class="top-product-rank">5</div>
                    <div class="top-product-info">
                        <div class="top-product-name">Áo khoác cardigan</div>
                        <div class="top-product-sold">Đã bán: 98</div>
                    </div>
                    <div class="top-product-revenue">4.5M</div>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>
